Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Favicon en la raíz (Google lo busca en /favicon.ico)
  RewriteRule ^favicon\.ico$ assets/images/logo_midoc.png [L]

  # robots.txt dinámico (Sitemap con URL completa)
  RewriteRule ^robots\.txt$ robots.php [L]

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
<FilesMatch "\.(sql|md|json|lock|log|gitignore|gitattributes|example\.php)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(notes\.txt|package\.json|package-lock\.json|composer\.json|plan\.md|HOSTINGER\.md)$">
  Require all denied
</FilesMatch>
